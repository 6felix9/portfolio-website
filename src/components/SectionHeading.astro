---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}

const { index, title, subtitle } = Astro.props;
---

<header class="mb-12 max-w-3xl md:mb-16">
  <p class="eyebrow flex items-center gap-3" data-reveal>
    <span>{index}</span>
    <span class="h-px w-10 bg-line-strong"></span>
  </p>
  <h2 class="h-section mt-4" data-reveal style="--i: 1">{title}</h2>
  {
    subtitle && (
      <p class="lead mt-4" data-reveal style="--i: 2">
        {subtitle}
      </p>
    )
  }
</header>
