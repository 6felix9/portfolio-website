---
import Icon from "./Icon.astro";
import site from "../data/site.json";
---

<header class="site-header" data-header>
  <div class="bar">
    <a href="#top" class="logo" aria-label={`${site.logoText} — back to top`}>
      {site.logoText}
    </a>

    <div class="right">
      <nav class="nav" aria-label="Primary" data-nav>
        <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
        {
          site.nav.map((item) => (
            <a href={item.href} class="nav-link" data-nav-link>
              {item.label}
            </a>
          ))
        }
      </nav>

      <button type="button" class="theme-btn" aria-label="Switch theme" data-theme-toggle>
        <Icon name="moon" size={17} class="moon" />
        <Icon name="sun" size={17} class="sun" />
      </button>

      <button
        type="button"
        class="menu-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu>
    <nav aria-label="Mobile" class="mobile-menu-inner">
      {
        site.nav.map((item, i) => (
          <a href={item.href} class="mobile-link" data-nav-link style={`--i: ${i}`}>
            <span class="eyebrow">{String(i + 1).padStart(2, "0")}</span>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding: 0.75rem 0.75rem 0;
    pointer-events: none;
  }

  /* The bar starts wide and transparent, then condenses into a floating pill
     once the page is scrolled. */
  .bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 72rem;
    height: 3.25rem;
    margin-inline: auto;
    padding-inline: 0.5rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    transition:
      max-width var(--dur-slow) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  @media (min-width: 768px) {
    .bar {
      padding-inline: 1.5rem 1rem;
    }
  }
  .site-header[data-scrolled] .bar,
  .site-header[data-open] .bar {
    background-color: var(--glass);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border-color: var(--color-line);
    box-shadow: 0 10px 30px -18px var(--shadow);
  }
  @media (min-width: 768px) {
    .site-header[data-scrolled] .bar {
      max-width: 44rem;
      padding-inline: 1.25rem 0.5rem;
    }
  }

  .logo {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* Desktop nav with a pill that slides to the hovered / current section */
  .nav {
    position: relative;
    display: none;
    align-items: center;
  }
  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }
  .nav-link {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .nav-link:hover,
  .nav-link[aria-current="true"] {
    color: var(--color-fg);
  }
  .nav-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.125rem;
    width: var(--w, 0px);
    border-radius: 9999px;
    background-color: var(--hover);
    opacity: var(--o, 0);
    transform: translate3d(var(--x, 0px), -50%, 0);
    transition:
      transform var(--dur) var(--ease),
      width var(--dur) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Theme toggle: moon in dark mode, sun in light mode. The two icons are
     stacked and swap with a quarter turn. */
  .theme-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: var(--color-muted);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .theme-btn:hover {
    color: var(--color-fg);
    background-color: var(--hover);
  }
  :global(html:not(.js)) .theme-btn {
    display: none;
  }
  .theme-btn :global(svg) {
    grid-area: 1 / 1;
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }
  .theme-btn :global(.sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-theme="light"]) .theme-btn :global(.sun) {
    opacity: 1;
    transform: none;
  }
  :global([data-theme="light"]) .theme-btn :global(.moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  /* Mobile menu */
  .menu-btn {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
  }
  @media (min-width: 768px) {
    .menu-btn {
      display: none;
    }
  }
  .menu-btn span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.125rem;
    height: 1.5px;
    margin-left: -0.5625rem;
    border-radius: 2px;
    background-color: currentColor;
    transition: transform var(--dur) var(--ease);
  }
  .menu-btn span:first-child {
    transform: translateY(-3.5px);
  }
  .menu-btn span:last-child {
    transform: translateY(3.5px);
  }
  .site-header[data-open] .menu-btn span:first-child {
    transform: rotate(45deg);
  }
  .site-header[data-open] .menu-btn span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    pointer-events: auto;
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0.5rem;
    border: 1px solid transparent;
    border-radius: 1.25rem;
    background-color: var(--glass-strong);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      grid-template-rows var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      visibility 0s linear var(--dur);
  }
  .site-header[data-open] .mobile-menu {
    grid-template-rows: 1fr;
    border-color: var(--color-line);
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
  .mobile-menu-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .mobile-link:first-child {
    padding-top: 1.25rem;
  }
  .mobile-link:last-child {
    padding-bottom: 1.25rem;
  }
  .mobile-link:hover,
  .mobile-link[aria-current="true"] {
    color: var(--color-fg);
  }
</style>
