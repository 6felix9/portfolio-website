---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import profile from "../data/profile.json";
import { asset } from "../lib/images";

const { hero } = profile;
const fullName = hero.nameLines.join(" ");

// Optional second photo for the light theme. Remove "portraitLight" from
// profile.json (or leave its src empty) to use the same photo in both themes.
const hasLight = Boolean(hero.portraitLight?.src);
---

<section id="top" class="hero">
  <div class="container-page hero-inner">
    <div class="copy">
      <h1 class="name" aria-label={fullName}>
        {
          hero.nameLines.map((line, i) => (
            <span class="name-line" data-reveal style={`--i: ${i}`} aria-hidden="true">
              {line}
            </span>
          ))
        }
      </h1>

      <hr class="rule" data-reveal="line" style="--i: 2" />

      <p class="build" data-reveal style="--i: 3">
        <span class="build-lead">{hero.lead}</span>{" "}
        <span class="flip" data-flip={JSON.stringify(hero.flipWords)}>
          <span class="sr-only">{hero.flipWords[0]}</span>
          {hero.flipWords.map((word) => <span class="flip-sizer" aria-hidden="true">{word}</span>)}
          <span class="flip-line" aria-hidden="true">
            <span class="flip-word" data-flip-word>{hero.flipWords[0]}</span><span class="caret"></span>
          </span>
        </span>
      </p>

      <p class="tagline" data-reveal style="--i: 4">{hero.tagline}</p>

      <div class="actions" data-reveal style="--i: 5">
        {
          hero.buttons.map((button) => (
            <a href={button.href} class:list={["btn", button.style === "primary" ? "btn-primary" : "btn-secondary"]}>
              {button.label}
            </a>
          ))
        }
        <span class="divider" aria-hidden="true"></span>
        <SocialLinks />
      </div>
    </div>

    <figure class="photo-wrap" data-reveal="photo">
      <div class="photo">
      <Image
        src={asset(hero.portrait.src)}
        alt={hero.portrait.alt}
        width={960}
        widths={[480, 720, 960]}
        sizes="(max-width: 768px) 100vw, 440px"
        loading="eager"
        class:list={["photo-img", hasLight && "photo-dark"]}
      />
      {
        hasLight && (
          <Image
            src={asset(hero.portraitLight.src)}
            alt={hero.portraitLight.alt}
            width={960}
            widths={[480, 720, 960]}
            sizes="(max-width: 768px) 100vw, 440px"
            loading="eager"
            class="photo-img photo-light"
          />
        )
      }
      </div>
    </figure>
  </div>

  <div class="scroll-cue-wrap" data-reveal style="--i: 8">
    <a href="#about" class="scroll-cue" aria-label="Scroll to About">
      <Icon name="arrow-down" size={16} />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: 6.5rem;
    padding-bottom: 5.5rem;
  }

  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero-inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3.5rem;
    }
  }

  .copy {
    container-type: inline-size;
  }

  /* ---- Name: the first thing you see -------------------------------- */
  .name {
    display: flex;
    flex-direction: column;
    font-size: min(9rem, 18cqi);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .name-line {
    display: block;
    white-space: nowrap;
  }

  /* ---- Photo: a large portrait card beside the name ------------------ */
  .photo {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 4 / 5;
    margin-inline: auto;
    border-radius: 1.25rem;
    overflow: hidden;
    background-color: var(--color-well);
    box-shadow:
      0 0 0 1px var(--color-line),
      0 40px 80px -40px var(--shadow);
  }
  .photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 22% 40%;
    transition: transform 1.4s var(--ease);
  }
  .photo:hover .photo-img {
    transform: scale(1.03);
  }
  .photo-light {
    display: none;
  }
  :global([data-theme="light"]) .photo-light {
    display: block;
  }
  :global([data-theme="light"]) .photo-dark {
    display: none;
  }

  /* Reveal: the card wipes open from the bottom while the photo settles.
     The clip sits on the inner .photo, never on the observed element, so the
     scroll observer can still see the wrapper and trigger it. */
  .photo-wrap {
    width: 100%;
  }
  :global(.js) .photo-wrap[data-reveal="photo"] {
    opacity: 1;
    filter: none;
    transform: none;
  }
  :global(.js) .photo-wrap[data-reveal="photo"] .photo {
    clip-path: inset(100% 0 0 0 round 1.25rem);
    transition: clip-path 1.2s var(--ease) 0.25s;
  }
  :global(.js) .photo-wrap[data-reveal="photo"] .photo-img {
    transform: scale(1.15);
    transition: transform 1.6s var(--ease) 0.25s;
  }
  :global(.js) .photo-wrap[data-reveal="photo"].is-in .photo {
    clip-path: inset(0 0 0 0 round 1.25rem);
  }
  :global(.js) .photo-wrap[data-reveal="photo"].is-in .photo-img {
    transform: none;
  }
  :global(.js) .photo-wrap[data-reveal="photo"].is-in .photo:hover .photo-img {
    transform: scale(1.03);
  }

  /* ---- Rule + details ------------------------------------------------ */
  .rule {
    width: 100%;
    height: 1px;
    margin-block: 2.25rem 1.75rem;
    border: 0;
    background-color: var(--color-line-strong);
  }

  .build {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .build-lead {
    color: var(--color-faint);
  }

  .flip {
    display: inline-grid;
    white-space: nowrap;
  }
  .flip-sizer,
  .flip-line {
    grid-area: 1 / 1;
  }
  .flip-sizer {
    visibility: hidden;
    padding-right: 0.5em;
  }
  .flip-line {
    display: inline-flex;
    align-items: baseline;
  }
  .caret {
    display: inline-block;
    align-self: center;
    width: 0.09em;
    height: 0.85em;
    margin-left: 0.08em;
    border-radius: 2px;
    background-color: var(--color-fg);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .flip-word :global(.flip-char) {
    display: inline-block;
    opacity: 0;
    transform: translate3d(0, 0.35em, 0);
    filter: blur(8px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      filter var(--dur) var(--ease);
    transition-delay: calc(var(--c, 0) * 32ms);
  }
  .flip-word.is-in :global(.flip-char) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .flip-word.is-out :global(.flip-char) {
    opacity: 0;
    transform: translate3d(0, -0.35em, 0);
    filter: blur(8px);
    transition-duration: 320ms;
    transition-delay: calc(var(--c, 0) * 14ms);
  }

  .tagline {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
  }
  .divider {
    width: 1px;
    height: 2rem;
    background-color: var(--color-line-strong);
  }
  @media (max-width: 479px) {
    .divider {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
    :global(.js) .photo-wrap[data-reveal="photo"] .photo,
    :global(.js) .photo-wrap[data-reveal="photo"] .photo-img {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }

  .scroll-cue-wrap {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    margin-left: -1.125rem;
  }
  .scroll-cue {
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    color: var(--color-faint);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  @media (min-width: 768px) and (min-height: 760px) {
    .scroll-cue {
      display: grid;
    }
  }
  .scroll-cue:hover {
    color: var(--color-fg);
    border-color: var(--color-line-strong);
  }
  .scroll-cue :global(svg) {
    animation: nudge 2.4s var(--ease) infinite;
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(2px);
    }
  }
</style>
